    "faq": [
      {
        "question": "Habe ich einen Rechtsanspruch auf Einstiegsgeld?",
        "answer": "Nein, das Einstiegsgeld ist eine Ermessensleistung. Das Jobcenter entscheidet im Einzelfall."
      },
      {
        "question": "Wie lange erhalte ich Einstiegsgeld?",
        "answer": "Maximal 24 Monate. Die genaue Dauer wird individuell festgelegt."
      },
      {
        "question": "Kann ich Einstiegsgeld mit Gründungszuschuss kombinieren?",
        "answer": "Nein, Einstiegsgeld und Gründungszuschuss schließen sich gegenseitig aus."
      }
    ]
