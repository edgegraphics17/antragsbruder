  "user_content": {
    "short_explanation": "Die Krankenkasse übernimmt die Kosten für Heilmittel (Physiotherapie, Ergotherapie, Logopädie etc.), wenn diese ärztlich verordnet sind.",
    "for_whom": "Für alle Versicherten, die aus medizinischen Gründen Heilmittel benötigen.",
    "requirements": "Sie müssen gesetzlich versichert sein und eine ärztliche Verordnung für die Heilmittel haben.",
    "how_mind": "Die Krankenkasse übernimmt die Kosten abzüglich einer Zuzahlung (10% + 10 Euro pro Verordnung).",
    "how_calculated": "Die Abrechnung erfolgt zwischen Heilmittelerbringer und Krankenkasse. Sie zahlen nur die Zuzahlung direkt beim Therapeuten.",
    "documents_needed": "Personalausweis, Krankenkassenkarte, Heilmittelverordnung vom Arzt",
    "where_to_apply": "Bei einem zugelassenen Heilmittelerbringer (Physiotherapeut, Ergotherapeut, Logopäde etc.)",
    "deadlines": "Verordnung innerhalb von 28 Tagen einlösen.",
    "faq": [
      {
        "question": "Wie viele Heilmittel kann ich gleichzeitig bekommen?",
        "answer": "Maximal 3 Heilmittel können gleichzeitig verordnet werden, davon maximal 1 ergänzendes Heilmittel."
      },
      {
        "question": "Was kostet das für mich?",
        "answer": "Sie zahlen 10% der Behandlungskosten plus 10 Euro pro Verordnung als Zuzahlung. Kinder unter 18 Jahren sind befreit."
      }
    ]
  },
