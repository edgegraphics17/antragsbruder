  "user_content": {
    "short_explanation": "Die Junglandwirte-Einkommensstützung ist eine jährliche Prämie für Landwirte unter 40 Jahren, die sich erstmals niedergelassen haben.",
    "for_whom": "Junge Landwirte und Landwirtinnen bis 40 Jahre, die ihren Betrieb erstmals leiten.",
    "requirements": "Maximal 40 Jahre alt, Betriebsleiter, maximal 120 ha förderfähige Fläche, einmalige Beantragung.",
    "how_much": "Ca. 134 Euro pro Hektar, maximal für 120 Hektar (ca. 16.080 Euro jährlich).",
    "how_calculated": "Die Prämie wird pauschal pro Hektar berechnet. Die gen Höhe wird jährlich festgelegt.",
    "documents_needed": "Flächenantrag, Altsnachweis, Nachweis der Betriebsleitung.",
    "where_to_apply": "Bei der zuständigen Zahlstelle (oft Landwirtschaftskammer) im Rahmen der Flächenantragstellung.",
    "deadlines": "Jährliche Antragsfrist: 15. Mai.",
    "faq": [
      {
        "question": "Kann ich die Junglandwirte-Prämie mit anderen Förderungen kombinieren?",
        "answer": "Ja, die Prämie ist mit der Investitionsförderung (AFP), Existenzgründungsförderung und Biobau-Förderung kombinierbar."
      },
      {
        "question": "Wie lange kann ich die Prämie erhalten?",
        "answer": "Maximal 5 Jahre ab dem Jahr der erstmaligen Beantragung."
      }
    ]
